{
  "name": "theos-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch server/index.ts",
    "dev:all": "bun run dev:server & bun run dev",
    "start": "bun server/index.ts",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:cast": "npm --prefix experiments/cast-raycast test",
    "typecheck": "tsc --noEmit",
    "postinstall": "ln -sf ../../../libsodium/dist/modules-esm/libsodium.mjs node_modules/libsodium-wrappers/dist/modules-esm/libsodium.mjs 2>/dev/null || true"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@types/three": "^0.183.1",
    "libsodium-wrappers": "^0.7.13",
    "pretext": "github:chenglou/pretext",
    "simplex-noise": "^4.0.1",
    "solid-js": "^1.9.12",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/jsdom": "^28.0.1",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.0.0",
    "@webgpu/types": "^0.1.69",
    "babel-preset-solid": "^1.9.12",
    "bun-types": "^1.1.0",
    "canvas": "^3.2.3",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.2",
    "puppeteer": "^24.40.0",
    "typescript": "^5.4.5",
    "vite": "^8.0.8",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^1.6.0"
  }
}
